# ---- Entrepôt de données cible (PostgreSQL local) ----
DW_HOST=localhost
DW_PORT=5432
DW_NAME=chu_dw
DW_USER=postgres
DW_PASSWORD=postgres

# ---- Base de staging (restauration du dump opérationnel DATA2023) ----
SRC_HOST=localhost
SRC_PORT=5432
SRC_NAME=chu_source
SRC_USER=postgres
SRC_PASSWORD=postgres

# ---- Outils PostgreSQL (laisser vide si déjà dans le PATH) ----
# Le dump DATA2023 provient de PostgreSQL 14.4 -> utiliser de préférence le client 14.
# Ex. Windows : C:\Program Files\PostgreSQL\14\bin
PG_BIN=

# ---- Réglages ETL ----
DECES_CHUNKSIZE=500000
DIM_TEMPS_START=2000-01-01
DIM_TEMPS_END=2025-12-31
